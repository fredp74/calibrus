# Calibrus — example configuration
# Copy this file to config.yaml and adapt it. NEVER COMMIT config.yaml
# if it contains plaintext credentials — use CALIBRUS_DB_PASSWORD instead.

data_source:
  type: csv                      # csv | parquet | mariadb

  csv:
    path: "examples/sample_data.csv"

  parquet:
    path: "data/signals.parquet"

  mariadb:
    host: "localhost"
    port: 3306
    database: "trading"
    table: "signals"
    user: "calibrus_user"
    password: ""                 # leave empty, use CALIBRUS_DB_PASSWORD as an env variable
    query: null                  # optional: custom SQL query instead of SELECT * FROM table

features:
  compute_ta:
    enabled: true
    indicators: ["rsi", "macd", "bbands", "ema", "atr"]
  text_model: "distilbert-base-uncased"
  max_text_len: 128

split:
  train_frac: 0.7
  val_frac: 0.15                 # the remainder (0.15 here) goes to test

train:
  batch_size: 16
  learning_rate: 0.00002
  epochs: 10
  freeze_text_encoder: false     # true recommended if dataset < a few thousand rows
  reg_loss_weight: 0.5
  early_stopping_patience: 3
